import boto3

ec2 = boto3.client("ec2")

def lambda_handler(event, context):

    instance_ids = [
        ""
    ]

    response = ec2.stop_instances(
        InstanceIds=instance_ids
    )

    print("EC2 instance stopped successfully")

    return {
        "statusCode": 200,
        "body": "EC2 instance stopped successfully"
    }
